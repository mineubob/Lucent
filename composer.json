{
  "name": "blueprintau/lucent",
  "type": "library",
  "description": "Lucent PHP web framework",
  "license": "MIT",
  "keywords": [
    "framework",
    "lucent",
    "php"
  ],
  "support": {
    "issues": "https://github.com/blueprintau/Lucent/issues",
    "source": "https://github.com/blueprintau/Lucent"
  },
  "authors": [
    {
      "name": "Jack Harris"
    },
    {
      "name": "Mineubob"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-fileinfo": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Lucent\\": "src/Lucent/"
    },
    "files": [
      "src/bootstrap.php"
    ],
    "exclude-from-classmap": [
      "tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Lucent\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/lucent"
  ],
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}